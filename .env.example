# =========================================================
# THE LENNY GROWTH ASSISTANT - ENVIRONMENT CONFIGURATION
# =========================================================

# Database Configuration
# Defaults to SQLite if not provided, or provide Supabase / Railway / Local Postgres
DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db
# DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_growth

# Active Model Provider ('ollama', 'claude', 'openai', 'mock')
DEFAULT_LLM_PROVIDER=ollama

# Local Ollama Settings (Mandatory for local demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM Settings (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
